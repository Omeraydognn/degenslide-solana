# ── Solana Whale Indexer (backend/solListener.js) ──
SOLANA_RPC=https://api.mainnet-beta.solana.com  # public RPC is rate-limited; use Helius/QuickNode in prod
PORT=8084                        # HTTP + WebSocket (REST: /whales /leaderboard /roster /health)
TRACK_MIN_USD=150                # minimum trade size (USD) that reaches the deck
WHALE_POLL_MS=7000               # per-wallet signature poll interval
WHALE_BATCH=8                    # wallets polled per tick
GMGN_SYNC_MINUTES=45             # whale-discovery sweep cadence
WHALE_DB=./solWhales.db          # durable whale registry

# ── Real-time whale tracking via Helius webhook (backend/heliusWebhook.js) ──
# HELIUS_API_KEY=
# HELIUS_WEBHOOK_SECRET=

# ── Optional extra discovery sources (backend/discoverySources.js) ──
# BIRDEYE_API_KEY=
# SOLANATRACKER_API_KEY=
# CIELO_API_KEY=
